# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key # frontend only; backend does not read this

# UPI Deep Linking
UPI_VPA=canteen@your-bank
UPI_PAYEE_NAME=Your Canteen Name
UPI_REDIRECT_BASE_URL=https://your-service.onrender.com

# WhatsApp (GetGabs); optional unless WhatsApp messaging/webhooks are enabled
GETGABS_API_KEY=
GETGABS_WEBHOOK_TOKEN=

# Frontend origins allowed to call the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Local Docker port; Render sets PORT automatically
PORT=10000
